# Free Tools MCP adapter.
# Preview/staging deployments default to the Free Tools surface once this code is deployed.
# Use QC_FREE_TOOLS_MCP_MODE=legacy only as an intentional rollback switch.
# Production remains legacy unless explicitly enabled with mode=free-tools or the old
# QC_FREE_TOOLS_MCP_ENABLED=true compatibility flag.
QC_FREE_TOOLS_MCP_MODE=free-tools
QC_FREE_TOOLS_MCP_ORIGIN=https://staging.example.com
QC_FREE_TOOLS_MCP_SECRET=
QC_FREE_TOOLS_MCP_STORAGE=supabase
QC_FREE_TOOLS_MCP_BUCKET=
# Exact HTTPS origins only, comma-separated. Never use wildcards, suffixes,
# paths or a guessed OpenAI hostname. With this blank, the first staging file
# call fails closed and reports only the rejected origin (never its signed URL).
QC_FREE_TOOLS_MCP_FILE_ORIGINS=

# The existing free roofing AI endpoint owns scan2/scan3 component proposals.
# Both existing gates still apply; the MCP workspace does not bypass them.
AI_TAKEOFF_ENABLED=true
FREE_AI_SCAN_ENABLED=true

# Existing Vercel cron authentication; required by the temporary-asset cleanup.
CRON_SECRET=
