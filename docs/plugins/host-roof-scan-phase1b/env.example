# Server-only. Do not commit real secrets. Existing settings are reused, not replaced.
QC_HOST_SCAN_ENABLED=false
QC_HOST_SCAN_ON_MAIN_MCP=false
QC_HOST_SCAN_ORIGIN=https://YOUR-STAGING-HOST.example
QC_HOST_SCAN_STORAGE=supabase
QC_HOST_SCAN_BUCKET=qc-host-outline-staging
QC_HOST_SCAN_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_SERVER_SIDE_IN_STAGING
# Exact HTTPS origins only. Empty is safe: use the browser upload panel first.
QC_HOST_SCAN_FILE_ORIGINS=
QC_HOST_SCAN_UI_ORIGINS=
# CLI-only; never put a deployment-protection bypass token in a URL or MCP metadata.
# QC_STAGE_ORIGIN=https://YOUR-STAGING-HOST.example
# QC_STAGE_PROTECTION_BYPASS=OPTIONAL_STAGING_CI_BYPASS_SECRET
