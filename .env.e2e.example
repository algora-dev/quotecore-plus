# QuoteCore+ E2E Test Harness — Environment Template
#
# Copy to .env.e2e and fill with real values.
# NEVER commit .env.e2e — it is gitignored.
#
# Safety Rule 1: BASE_URL must be exactly the dev host.
E2E_BASE_URL=https://quotecore-plus-dev.vercel.app

# --- Account Credentials ---
# Five ordinary E2E accounts (created via dev admin UI).

# E2E Trial Company A
E2E_TRIAL_A_EMAIL=e2e-trial-a@quotecore.invalid
E2E_TRIAL_A_PASSWORD=
E2E_TRIAL_A_SLUG=

# E2E Starter Company B
E2E_STARTER_B_EMAIL=e2e-starter-b@quotecore.invalid
E2E_STARTER_B_PASSWORD=
E2E_STARTER_B_SLUG=

# E2E Paid Company C (Pro or Pro Plus)
E2E_PAID_C_EMAIL=e2e-paid-c@quotecore.invalid
E2E_PAID_C_PASSWORD=
E2E_PAID_C_SLUG=

# E2E CrossTenant Company D
E2E_CROSS_D_EMAIL=e2e-cross-d@quotecore.invalid
E2E_CROSS_D_PASSWORD=
E2E_CROSS_D_SLUG=

# E2E Onboarding User E (incomplete onboarding)
E2E_ONBOARD_E_EMAIL=e2e-onboard-e@quotecore.invalid
E2E_ONBOARD_E_PASSWORD=
E2E_ONBOARD_E_SLUG=

# --- Email Testing (opt-in) ---
# Must be "true" to enable email send tests.
E2E_ALLOW_EMAIL_SEND=false
# Must exactly match the approved recipient.
E2E_SAFE_RECIPIENT_EMAIL=secarter23@gmail.com
