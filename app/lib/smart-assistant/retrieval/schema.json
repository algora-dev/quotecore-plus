      "from": "public.catalog_rows r JOIN public.catalogs c ON c.id=r.catalog_id AND c.company_id=r.company_id",
      "scope": "r.company_id=($1->>'company_id')::uuid AND c.company_id=($1->>'company_id')::uuid AND c.status='ready'",
