        },
        "quote": {
          "source": "quotes",
          "local": "related_quote_id",
          "foreign": "id"
        }
      },
      "ownerField": "created_by",
      "targetKindSql": "'invoice'::text",
      "targetId": "id",
      "sectionSql": "'invoices'::text",
      "note": "Stored invoices. Totals are already calculated by the application. Always group money by currency; never do model arithmetic."
    },
