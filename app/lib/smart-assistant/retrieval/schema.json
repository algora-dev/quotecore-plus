        "related_quote_id": {
          "sql": "CASE WHEN i.source_type='quote' AND EXISTS(SELECT 1 FROM public.quotes pq WHERE pq.id=i.source_id AND pq.company_id=i.company_id AND COALESCE($1->'permissions'->>(CASE WHEN pq.status::text='draft' THEN 'draft_quotes' ELSE 'quotes' END),'hidden')<>'hidden') THEN i.source_id ELSE NULL END",
          "type": "uuid",
